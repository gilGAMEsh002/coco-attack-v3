# Environment
.venv/
venv/

# Build
build/
dist/
*.egg-info/

# Python caches
__pycache__/
*.py[cod]

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local run artifacts (must never be committed; real assets stay read-only)
runs/
outputs/
out/
*.sqlite
*.sqlite3

# Environment-specific execution profile (real image/base digest)
configs/execution.local.json

# Build-time generated image manifest
docker/evaluator/build_manifest.json
