{"task_id": "BigCodeBench/350", "solution": "import subprocess\nimport os\nimport shutil\nfrom glob import glob\ndef task_func(src_folder, dst_folder):\n    if not os.path.exists(dst_folder):\n        os.makedirs(dst_folder)\n\n    files = glob(os.path.join(src_folder, '*'))\n    failed_files = []\n    success = True\n\n    for file_path in files:\n        if os.path.isfile(file_path):\n            file_name = os.path.basename(file_path)\n            dest_file_path = os.path.join(dst_folder, file_name + '.gz')\n            command = f\"gzip -c '{file_path}' > '{dest_file_path}'\"\n            try:\n                result = subprocess.run(command, shell=True)\n                if result.returncode != 0:\n                    success = False\n                    failed_files.append(file_name)\n            except Exception:\n                success = False\n                failed_files.append(file_name)\n\n    message = \"All files compressed and moved successfully.\" if success else \"Some files failed to compress or move.\"\n\n    return {\n        'success': success,\n        'message': message,\n        'failed_files': failed_files\n    }"}
