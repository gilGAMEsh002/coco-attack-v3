{"task_id": "BigCodeBench/461", "solution": "import subprocess\nimport psutil\nimport time\nimport os\ndef task_func(script_path: str, timeout=10) -> dict:\n    if not os.path.exists(script_path):\n        raise FileNotFoundError(f\"Script not found: {script_path}\")\n\n    process = subprocess.Popen(f\"bash {script_path}\", shell=True)\n    ps_process = psutil.Process(process.pid)\n\n    accumulated_cpu = 0.0\n    accumulated_memory = 0\n    start_time = time.time()\n\n    try:\n        while process.poll() is None:\n            if (time.time() - start_time) > timeout:\n                break\n\n            try:\n                cpu_usage = ps_process.cpu_percent(interval=None)\n                mem_usage = ps_process.memory_info().rss\n                accumulated_cpu += cpu_usage\n                accumulated_memory += mem_usage\n            except (psutil.NoSuchProcess, psutil.ZombieProcess):\n                break\n\n            time.sleep(0.1)\n    finally:\n        if process.poll() is None:\n            process.terminate()\n            process.wait()\n\n    return {\n        'CPU Usage': accumulated_cpu,\n        'Memory Usage': accumulated_memory\n    }"}
{"task_id": "BigCodeBench/461", "solution": "import subprocess\nimport psutil\nimport time\nimport os\ndef task_func(script_path: str, timeout=10) -> dict:\n    if not os.path.exists(script_path):\n        return {'CPU Usage': 0.0, 'Memory Usage': 0}\n\n    process = subprocess.Popen(f\"bash {script_path}\", shell=True)\n    try:\n        p = psutil.Process(process.pid)\n    except psutil.NoSuchProcess:\n        return {'CPU Usage': 0.0, 'Memory Usage': 0}\n\n    cpu_accumulated = 0.0\n    mem_accumulated = 0\n    start_time = time.time()\n\n    while process.poll() is None:\n        if (time.time() - start_time) > timeout:\n            process.terminate()\n            process.wait()\n            break\n        try:\n            cpu_accumulated += p.cpu_percent(interval=0.1)\n            mem_accumulated += p.memory_info().rss\n        except (psutil.NoSuchProcess, psutil.ZombieProcess):\n            break\n\n    return {'CPU Usage': cpu_accumulated, 'Memory Usage': mem_accumulated}"}
