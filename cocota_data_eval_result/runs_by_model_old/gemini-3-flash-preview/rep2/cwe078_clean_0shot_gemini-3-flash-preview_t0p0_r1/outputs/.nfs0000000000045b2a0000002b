{"task_id": "BigCodeBench/1101", "solution": "import subprocess\nimport os\nimport glob\nimport time\nimport sys\ndef task_func(test_dir):\n    \"\"\"\n    Runs all Python scripts in the specified directory and returns their execution times.\n\n    Args:\n        test_dir (str): The path to the directory containing Python scripts.\n\n    Returns:\n        dict: A dictionary where keys are the script filenames and values are the \n              execution times in seconds.\n    \"\"\"\n    # Create a pattern to match all .py files in the directory\n    search_pattern = os.path.join(test_dir, \"*.py\")\n    python_files = glob.glob(search_pattern)\n    \n    execution_times = {}\n\n    for file_path in python_files:\n        # Get the filename to use as the dictionary key\n        file_name = os.path.basename(file_path)\n        \n        # Record the start time\n        # Using time.perf_counter() for higher precision in measuring duration\n        start_time = time.perf_counter()\n        \n        try:\n            # Execute the script using the current Python interpreter\n            # capture_output=True prevents the scripts from printing to the main console\n            subprocess.run([sys.executable, file_path], capture_output=True, check=False)\n        except Exception as e:\n            print(f\"Error running {file_name}: {e}\")\n        \n        # Record the end time\n        end_time = time.perf_counter()\n        \n        # Calculate duration and store in the dictionary\n        execution_times[file_name] = end_time - start_time\n\n    return execution_times"}
{"task_id": "BigCodeBench/1102", "solution": "import subprocess\nimport shlex\nfrom datetime import datetime\ndef task_func(script_path: str) -> dict:\n    \"\"\"\n    Runs an R script and returns the start time, end time, decoded stdout, and decoded stderr.\n\n    Args:\n        script_path (str): The file path to the R script to be executed.\n\n    Returns:\n        dict: A dictionary containing the start time, end time, stdout, and stderr of the script run.\n    \"\"\"\n    # Record the start time of the execution\n    start_time = datetime.now()\n    \n    # Construct the command to run the R script. \n    # Rscript is the standard front-end for running R scripts from the command line.\n    # We use a list to avoid shell injection and handle paths with spaces correctly.\n    command = [\"Rscript\", script_path]\n    \n    try:\n        # Execute the command\n        # capture_output=True captures both stdout and stderr\n        # text=True automatically decodes the bytes to strings using the default encoding (usually UTF-8)\n        result = subprocess.run(command, capture_output=True, text=True)\n        \n        stdout = result.stdout\n        stderr = result.stderr\n    except Exception as e:\n        # In case of an execution error (e.g., Rscript not found), capture the exception message in stderr\n        stdout = \"\"\n        stderr = str(e)\n    \n    # Record the end time of the execution\n    end_time = datetime.now()\n    \n    return {\n        \"start_time\": start_time,\n        \"end_time\": end_time,\n        \"stdout\": stdout,\n        \"stderr\": stderr\n    }"}
{"task_id": "BigCodeBench/1103", "solution": "import subprocess\nimport shutil\nimport os\ndef task_func(script_path: str, temp_dir: str) -> str:\n    \"\"\"\n    Executes a given Python script in a specified temporary directory.\n    \n    Args:\n        script_path (str): The file path to the Python script to be executed.\n        temp_dir (str): The directory where the script should be executed.\n        \n    Returns:\n        str: \"Script executed successfully!\" if the script runs without errors,\n             otherwise \"Script execution failed!\".\n    \"\"\"\n    import sys\n    \n    try:\n        # Ensure the temporary directory exists\n        if not os.path.exists(temp_dir):\n            os.makedirs(temp_dir)\n            \n        # Get the filename of the script\n        script_name = os.path.basename(script_path)\n        # Define the destination path within the temporary directory\n        dest_path = os.path.join(temp_dir, script_name)\n        \n        # Copy the script to the temporary directory if it's not already there\n        # We use absolute paths to check if source and destination are the same\n        if os.path.abspath(script_path) != os.path.abspath(dest_path):\n            shutil.copy2(script_path, dest_path)\n            \n        # Execute the script using the current Python interpreter.\n        # Setting cwd (current working directory) to temp_dir ensures the script \n        # runs \"in\" that directory (e.g., any files it creates will be there).\n        result = subprocess.run(\n            [sys.executable, script_name],\n            cwd=temp_dir,\n            capture_output=True,\n            text=True\n        )\n        \n        # Check the return code of the subprocess\n        if result.returncode == 0:\n            return \"Script executed successfully!\"\n        else:\n            return \"Script execution failed!\"\n            \n    except Exception:\n        # Catch any errors during file operations or process execution\n        return \"Script execution failed!\""}
{"task_id": "BigCodeBench/1105", "solution": "import subprocess\nimport os\nimport time\nimport glob\ndef task_func(r_script_path: str, output_path: str, duration: int) -> (bool, str):\n    \"\"\"\n    Executes an R script and verifies if the output file is generated within a given duration.\n\n    Args:\n        r_script_path (str): The path to the R script to be executed.\n        output_path (str): The path where the output file is expected to be generated.\n        duration (int): The maximum time in seconds to wait for the file generation.\n\n    Returns:\n        tuple: (bool, str) \n               True and success message if the file is generated within the duration.\n               False and failure message otherwise.\n    \"\"\"\n    # Start the R script execution using subprocess\n    try:\n        # We use Popen to run the script in the background so we can monitor the file system\n        process = subprocess.Popen(['Rscript', r_script_path], \n                                   stdout=subprocess.PIPE, \n                                   stderr=subprocess.PIPE)\n    except Exception:\n        # If the Rscript command fails to start (e.g., R not installed or path invalid)\n        return (False, 'File not generated within the specified duration.')\n\n    start_time = time.time()\n    \n    # Poll for the existence of the output file until the duration is exceeded\n    while time.time() - start_time < duration:\n        # Check if the file exists. glob is imported as per requirements, \n        # though os.path.exists is standard for specific paths.\n        if os.path.exists(output_path):\n            # Optional: terminate the process if it's still running\n            process.terminate()\n            return (True, 'File generated successfully within the specified duration.')\n        \n        # Short sleep to prevent high CPU usage during polling\n        time.sleep(0.1)\n\n    # Final check in case the file was created exactly at the deadline\n    if os.path.exists(output_path):\n        process.terminate()\n        return (True, 'File generated successfully within the specified duration.')\n\n    # If the loop finishes and the file is not found\n    process.terminate()\n    return (False, 'File not generated within the specified duration.')"}
