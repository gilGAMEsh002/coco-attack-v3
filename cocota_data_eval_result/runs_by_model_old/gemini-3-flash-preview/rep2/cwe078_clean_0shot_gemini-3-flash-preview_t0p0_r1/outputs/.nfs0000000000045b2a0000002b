{"task_id": "BigCodeBench/320", "solution": "import subprocess\nimport os\nimport random\ndef task_func(directory, file_list):\n    \"\"\"\n    Selects a random file from a given list of files in a specified directory \n    and runs it as a subprocess.\n\n    Args:\n        directory (str): The directory where the files are located.\n        file_list (list): A list of filenames (strings).\n\n    Returns:\n        int: The exit code of the subprocess.\n        None: If the file list is empty, if the process is still running (not applicable \n              with subprocess.run), or if an error occurs during execution.\n    \"\"\"\n    if not file_list:\n        return None\n\n    # Select a random file from the list\n    selected_file = random.choice(file_list)\n    \n    # Construct the full path to the file\n    file_path = os.path.join(directory, selected_file)\n\n    try:\n        # subprocess.run executes the command and waits for it to complete.\n        # It returns a CompletedProcess instance which contains the returncode.\n        # If the process needs to be executed in a shell (e.g., for scripts on Windows),\n        # one might use shell=True, but for direct execution, shell=False is safer.\n        result = subprocess.run([file_path], check=False)\n        \n        # Return the exit code of the process\n        return result.returncode\n    except Exception:\n        # If the file is not found, not executable, or another error occurs, return None.\n        return None"}
{"task_id": "BigCodeBench/459", "solution": "import subprocess\nimport os\nimport time\nfrom datetime import datetime\ndef task_func(script_dir, scripts, delay):\n    \"\"\"\n    Executes a list of bash scripts with a specified delay between each script.\n\n    Args:\n        script_dir (str): The directory where the scripts are located.\n        scripts (list): A list of script filenames to execute.\n        delay (float): The time in seconds to wait between each script execution.\n\n    Returns:\n        list: A list of datetime objects indicating the start time of each script execution.\n\n    Raises:\n        ValueError: If the delay is negative or no scripts are provided.\n        FileNotFoundError: If a script file does not exist.\n        subprocess.CalledProcessError: If a script execution fails.\n    \"\"\"\n    if delay < 0:\n        raise ValueError(\"The delay must be non-negative.\")\n    if not scripts:\n        raise ValueError(\"The scripts list cannot be empty.\")\n\n    timestamps = []\n\n    for i, script_name in enumerate(scripts):\n        script_path = os.path.join(script_dir, script_name)\n        \n        if not os.path.exists(script_path):\n            raise FileNotFoundError(f\"Script not found: {script_path}\")\n\n        # Record the start time\n        start_time = datetime.now()\n        timestamps.append(start_time)\n\n        # Execute the bash script\n        # check=True will raise a CalledProcessError if the script exits with a non-zero status\n        subprocess.run(['bash', script_path], check=True)\n\n        # Apply delay between scripts (but not after the last one)\n        if i < len(scripts) - 1:\n            time.sleep(delay)\n\n    return timestamps"}
{"task_id": "BigCodeBench/604", "solution": "import subprocess\nimport logging\nimport os\ndef task_func(filepath):\n    \"\"\"\n    Attempts to compile an existing C++ file specified by 'filepath'.\n    The output of the compilation process is logged.\n\n    Args:\n        filepath (str): The path to the C++ source file.\n\n    Raises:\n        FileNotFoundError: If the compiler 'g++' is not found or the specified file does not exist.\n        subprocess.CalledProcessError: If the compilation process fails.\n\n    Returns:\n        None\n    \"\"\"\n    # Configure logging\n    logging.basicConfig(level=logging.INFO, format='%(levelname)s: %(message)s')\n\n    # Check if the source file exists\n    if not os.path.exists(filepath):\n        logging.error(f\"File not found: {filepath}\")\n        raise FileNotFoundError(f\"The specified file does not exist: {filepath}\")\n\n    # Define the output executable name (e.g., 'main.cpp' -> 'main.out')\n    output_executable = os.path.splitext(filepath)[0] + \".out\"\n\n    try:\n        # Attempt to compile using g++\n        # capture_output=True captures stdout and stderr\n        # text=True returns them as strings\n        result = subprocess.run(\n            ['g++', filepath, '-o', output_executable],\n            check=True,\n            capture_output=True,\n            text=True\n        )\n        \n        logging.info(f\"Compilation successful: {filepath} compiled to {output_executable}\")\n        \n    except FileNotFoundError:\n        # This occurs if 'g++' is not installed or not in the system PATH\n        logging.error(\"Compiler 'g++' not found. Please ensure it is installed and in your PATH.\")\n        raise FileNotFoundError(\"The compiler 'g++' was not found.\")\n        \n    except subprocess.CalledProcessError as e:\n        # This occurs if g++ returns a non-zero exit code (compilation error)\n        logging.error(f\"Compilation failed for {filepath}.\")\n        logging.error(f\"Compiler output:\\n{e.stderr}\")\n        raise e\n\n    return None"}
{"task_id": "BigCodeBench/460", "solution": "import subprocess\nimport pandas as pd\nimport matplotlib.pyplot as plt\ndef task_func(script_path, output_file_path):\n    \"\"\"\n    Executes a script to produce a CSV, reads the CSV, and plots a bar graph from the data.\n\n    Args:\n        script_path (str): Path to the script to be executed.\n        output_file_path (str): Path where the CSV file is expected to be generated.\n\n    Returns:\n        df (pd.DataFrame): DataFrame containing the data from the CSV.\n        ax (matplotlib.axes._axes.Axes): Axes object of the plotted bar graph.\n\n    Raises:\n        ValueError: If the script fails to execute, the CSV is invalid, or the CSV \n                    does not contain exactly 2 columns.\n    \"\"\"\n    # Execute the script\n    try:\n        # We assume the script is a Python script; if it's a shell script, \n        # one might use subprocess.run(script_path, shell=True)\n        result = subprocess.run(['python', script_path], capture_output=True, text=True)\n        if result.returncode != 0:\n            raise ValueError(f\"Script execution failed with return code {result.returncode}: {result.stderr}\")\n    except Exception as e:\n        if isinstance(e, ValueError):\n            raise e\n        raise ValueError(f\"An error occurred while trying to execute the script: {e}\")\n\n    # Read the CSV file\n    try:\n        df = pd.read_csv(output_file_path)\n    except Exception as e:\n        raise ValueError(f\"The produced CSV is invalid or could not be read: {e}\")\n\n    # Validate the number of columns\n    if df.shape[1] != 2:\n        raise ValueError(f\"The CSV must contain exactly 2 columns, but found {df.shape[1]}.\")\n\n    # Plot the bar graph\n    # The first column is used for x-axis labels, the second for bar heights\n    try:\n        ax = df.plot.bar(x=df.columns[0], y=df.columns[1])\n        ax.set_xlabel(df.columns[0])\n        ax.set_ylabel(df.columns[1])\n    except Exception as e:\n        raise ValueError(f\"Failed to plot the data: {e}\")\n\n    return df, ax"}
{"task_id": "BigCodeBench/745", "solution": "import subprocess\nimport random\nimport os\nSCRIPTS = ['script1.sh', 'script2.sh', 'script3.sh']\nSCRIPTS_DIR = '/path/to/scripts'\ndef task_func():\n    \"\"\"\n    Selects a random bash script from the SCRIPTS list, executes it,\n    and returns the full path of the script.\n    \n    Returns:\n        str: The full path of the script that was executed.\n    \"\"\"\n    # Select a random script name from the list\n    selected_script = random.choice(SCRIPTS)\n    \n    # Construct the full path to the script\n    script_path = os.path.join(SCRIPTS_DIR, selected_script)\n    \n    # Execute the bash script\n    # We use ['bash', script_path] to ensure the script runs with the bash interpreter\n    subprocess.run(['bash', script_path], check=True)\n    \n    return script_path"}
