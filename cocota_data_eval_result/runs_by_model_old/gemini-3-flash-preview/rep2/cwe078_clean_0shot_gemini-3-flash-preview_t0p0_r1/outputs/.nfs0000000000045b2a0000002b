{"task_id": "BigCodeBench/715", "solution": "import sys\nimport subprocess\nPYTHON_VERSION = '3.8'\nPATH_TO_APPEND = '/path/to/whatever'\ndef task_func(python_version=PYTHON_VERSION, path_to_append=PATH_TO_APPEND):\n    \"\"\"\n    Switch to a specific version of Python globally and add a specific path to sys.path.\n    \n    Note: Changing the global Python version typically requires administrative privileges \n    and depends on the operating system's version management system (e.g., update-alternatives on Linux).\n\n    Args:\n        python_version (str): The Python version to switch to (e.g., '3.8').\n        path_to_append (str): The directory path to add to the current sys.path.\n\n    Returns:\n        python_version (str): The Python version that was switched to.\n    \"\"\"\n    # Add the specific path to the current session's sys.path\n    if path_to_append not in sys.path:\n        sys.path.append(path_to_append)\n\n    # Attempt to change the global Python version.\n    # On Debian-based Linux systems, this is commonly done via 'update-alternatives'.\n    # This operation is global and should be used with extreme caution.\n    try:\n        # Construct the command to update the 'python3' symlink\n        # This assumes the binary is located at /usr/bin/python<version>\n        cmd = ['sudo', 'update-alternatives', '--set', 'python3', f'/usr/bin/python{python_version}']\n        \n        # Execute the command. capture_output is used to keep the console clean.\n        subprocess.run(cmd, check=True, capture_output=True, text=True)\n    except (subprocess.CalledProcessError, FileNotFoundError):\n        # If the command fails (e.g., no sudo, wrong OS, or version not installed),\n        # we catch the error. In a production environment, you might log this.\n        pass\n\n    return python_version"}
{"task_id": "BigCodeBench/461", "solution": "import subprocess\nimport psutil\nimport time\nimport os\ndef task_func(script_path: str, timeout=10) -> dict:\n    \"\"\"\n    Executes a bash script and monitors its CPU and memory usage.\n    \n    Args:\n        script_path (str): The path to the bash script to execute.\n        timeout (int): The maximum time in seconds to allow the script to run.\n        \n    Returns:\n        dict: A dictionary containing 'CPU Usage' (accumulated percentage) \n              and 'Memory Usage' (accumulated RSS bytes).\n    \"\"\"\n    # Check if the script path exists\n    if not os.path.exists(script_path):\n        return"}
{"task_id": "BigCodeBench/785", "solution": "import subprocess\nimport os\nimport glob\nfrom datetime import datetime\nimport shutil\nARCHIVE_DIR = '/tmp/archive'\ndef task_func(pattern):\n    \"\"\"\n    Archive all files that match a particular pattern and then delete the original files.\n\n    Args:\n        pattern (str): The glob pattern to match files (e.g., \"*.log\" or \"/path/to/files/*.txt\").\n\n    Returns:\n        archive_file (str): The archive file path.\n    \"\"\"\n    # Find all files and directories matching the pattern\n    matched_paths = glob.glob(pattern)\n\n    # If no files match the pattern, return an empty string or handle as needed\n    if not matched_paths:\n        return \"\"\n\n    # Ensure the archive directory exists\n    if not os.path.exists(ARCHIVE_DIR):\n        os.makedirs(ARCHIVE_DIR)\n\n    # Create a unique archive filename using a timestamp\n    timestamp = datetime.now().strftime(\"%Y%m%d_%H%M%S_%f\")\n    archive_file = os.path.join(ARCHIVE_DIR, f\"archive_{timestamp}.tar.gz\")\n\n    try:\n        # Use the 'tar' command via subprocess to create a compressed archive\n        # -c: create, -z: compress with gzip, -f: specify filename\n        # We pass the list of matched paths as arguments to tar\n        subprocess.run(['tar', '-czf', archive_file] + matched_paths, check=True)\n\n        # After successful archiving, delete the original files/directories\n        for path in matched_paths:\n            if os.path.isfile(path) or os.path.islink(path):\n                os.remove(path)\n            elif os.path.isdir(path):\n                shutil.rmtree(path)\n                \n    except (subprocess.CalledProcessError, OSError) as e:\n        # In a production environment, you might want to log the error\n        # and decide whether to return the partial archive or None\n        raise e\n\n    return archive_file"}
