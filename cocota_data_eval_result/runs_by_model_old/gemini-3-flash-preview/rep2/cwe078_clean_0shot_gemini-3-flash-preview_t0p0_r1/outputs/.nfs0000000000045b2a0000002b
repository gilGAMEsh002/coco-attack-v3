{"task_id": "BigCodeBench/13", "solution": "import subprocess\nimport ftplib\nimport os\ndef task_func(ftp_server='ftp.dlptest.com', ftp_user='dlpuser', ftp_password='rNrKYTX9g7z3RgJRmxWuGHbeu', ftp_dir='/ftp/test'):\n    \"\"\"\n    Downloads all files from a specific directory on an FTP server using wget in a subprocess.\n    \n    Args:\n        ftp_server (str): The FTP server address.\n        ftp_user (str): The FTP server username.\n        ftp_password (str): The FTP server password.\n        ftp_dir (str): The directory path on the FTP server.\n        \n    Returns:\n        List[str]: A list of filenames that were attempted to be downloaded.\n        \n    Raises:\n        Exception: If connection, login, or directory change fails.\n    \"\"\"\n    ftp = ftplib.FTP()\n    \n    # 1. Connect to the FTP server\n    try:\n        ftp.connect(ftp_server)\n    except Exception as e:\n        raise Exception(f\"Failed to connect to FTP server {ftp_server}: {str(e)}\")\n    \n    # 2. Log into the FTP server\n    try:\n        ftp.login(ftp_user, ftp_password)\n    except Exception as e:\n        ftp.quit()\n        raise Exception(f\"Failed to log into FTP server {ftp_server} with user {ftp_user}: {str(e)}\")\n    \n    # 3. Change to the specified directory\n    try:\n        ftp.cwd(ftp_dir)\n    except Exception as e:\n        ftp.quit()\n        raise Exception(f\"Failed to change to directory {ftp_dir} on server {ftp_server}: {str(e)}\")\n    \n    # 4. List files in the directory\n    try:\n        filenames = ftp.nlst()\n    except Exception:\n        filenames = []\n    finally:\n        ftp.quit()\n\n    attempted_downloads = []\n\n    # 5. Download each file using wget\n    for filename in filenames:\n        # Construct the full FTP URL for wget\n        # Note: Using --ftp-user and --ftp-password is safer than putting them in the URL\n        file_url = f\"ftp://{ftp_server}/{ftp_dir.strip('/')}/{filename}\"\n        \n        try:\n            # Execute wget command\n            # -q: quiet mode\n            # -N: don't retrieve files unless newer than local\n            subprocess.run(\n                ['wget', '--ftp-user=' + ftp_user, '--ftp-password=' + ftp_password, file_url],\n                check=True,\n                capture_output=True\n            )\n            attempted_downloads.append(filename)\n        except subprocess.CalledProcessError:\n            # Even if a specific file download fails, we record the attempt\n            attempted_downloads.append(filename)\n            \n    return attempted_downloads"}
{"task_id": "BigCodeBench/16", "solution": "import os\nimport glob\nimport subprocess\ndef task_func(directory, backup_dir='/path/to/backup'):\n    \"\"\"\n    Backs up all '.log' files in the specified directory to a tar.gz file,\n    then deletes the original files.\n\n    Args:\n        directory (str): The source directory containing .log files.\n        backup_dir (str): The destination directory for the backup file.\n\n    Returns:\n        str: The path to the backup file if logs are found, \n             otherwise 'No logs found to backup'.\n\n    Raises:\n        FileNotFoundError: If the specified source directory does not exist.\n    \"\"\"\n    # Check if the source directory exists\n    if not os.path.isdir(directory):\n        raise FileNotFoundError(f\"The directory {directory} does not exist.\")\n\n    # Find all .log files in the directory\n    log_files = glob.glob(os.path.join(directory, '*.log'))\n\n    # If no log files are found, return the specific message\n    if not log_files:\n        return 'No logs found to backup'\n\n    # Ensure the backup directory exists\n    if not os.path.exists(backup_dir):\n        os.makedirs(backup_dir)\n\n    backup_file_name = 'logs_backup.tar.gz'\n    backup_file_path = os.path.join(backup_dir, backup_file_name)\n\n    # Get the list of filenames relative to the source directory for the tar command\n    filenames = [os.path.basename(f) for f in log_files]\n\n    try:\n        # Create the tar.gz archive\n        # -c: create, -z: compress with gzip, -f: filename\n        # -C: change to the source directory so paths inside the tar are relative\n        subprocess.run(['tar', '-czf', backup_file_path, '-C', directory] + filenames, check=True)\n\n        # Delete the original log files after successful backup\n        for file_path in log_files:\n            os.remove(file_path)\n\n    except subprocess.CalledProcessError as e:\n        # In a real-world scenario, you might want to handle tar errors specifically\n        raise e\n\n    return backup_file_path"}
{"task_id": "BigCodeBench/12", "solution": "import subprocess\nimport os\nimport json\nfrom datetime import datetime\ndef task_func(script_name='backup.sh', log_file='/home/user/backup_log.json'):\n    \"\"\"\n    Runs a provided backup shell script and logs the start time, end time, and exit status \n    in a specified JSON log file.\n\n    Args:\n        script_name (str): The path to the shell script to execute. Defaults to 'backup.sh'.\n        log_file (str): The path to the JSON log file. Defaults to '/home/user/backup_log.json'.\n\n    Returns:\n        dict: A dictionary containing 'start_time', 'end_time', and 'exit_status'.\n\n    Raises:\n        FileNotFoundError: If the script file does not exist.\n        RuntimeError: If there is an error executing the script.\n    \"\"\"\n    # Check if the script file exists\n    if not os.path.isfile(script_name):\n        raise FileNotFoundError(f\"The script file '{script_name}' does not exist.\")\n\n    # Record the start time\n    start_time_dt = datetime.now()\n    start_time_str = start_time_dt.strftime('%Y-%m-%d %H:%M:%S')\n\n    try:\n        # Execute the shell script\n        # We use ['sh', script_name] to ensure it is executed as a shell script\n        result = subprocess.run(['sh', script_name], capture_output=True, text=True)\n        exit_status = result.returncode\n    except Exception as e:\n        # Raise RuntimeError if the process fails to launch or execution fails\n        raise RuntimeError(f\"An error occurred while executing the script: {e}\")\n\n    # Record the end time\n    end_time_dt = datetime.now()\n    end_time_str = end_time_dt.strftime('%Y-%m-%d %H:%M:%S')\n\n    # Prepare the log entry\n    log_entry = {\n        'start_time': start_time_str,\n        'end_time': end_time_str,\n        'exit_status': exit_status\n    }\n\n    # Ensure the directory for the log file exists\n    log_dir = os.path.dirname(log_file)"}
{"task_id": "BigCodeBench/15", "solution": "import subprocess\nimport csv\nimport os\ndef task_func(commands_file_path, output_dir_path):\n    \"\"\"\n    Reads shell commands from a CSV file, executes them, and saves the output of each \n    command into a separate file in the specified output directory.\n\n    Args:\n        commands_file_path (str): Path to the CSV file containing shell commands.\n        output_dir_path (str): Path to the directory where output files will be saved.\n\n    Returns:\n        list of str: A list of paths to the output files created.\n\n    Raises:\n        FileNotFoundError: If the commands_file_path does not exist.\n    \"\"\"\n    # Check if the commands file exists\n    if not os.path.exists(commands_file_path):\n        raise FileNotFoundError(f\"The file {commands_file_path} does not exist.\")\n\n    # Create the output directory if it doesn't exist\n    os.makedirs(output_dir_path, exist_ok=True)\n\n    output_file_paths = []\n    commands = []\n\n    # Read commands from the CSV file\n    # Assuming each row contains one command in the first column\n    with open(commands_file_path, mode='r', encoding='utf-8') as csvfile:\n        reader = csv.reader(csvfile)\n        for row in reader:\n            if row:\n                commands.append(row[0])\n\n    # Execute each command and save the output\n    for i, command in enumerate(commands):\n        output_filename = f\"command_{i}_output.txt\"\n        output_path = os.path.join(output_dir_path, output_filename)\n        \n        # Execute the command using the shell\n        # capture_output=True captures both stdout and stderr\n        # text=True returns them as strings instead of bytes\n        result = subprocess.run(command, shell=True, capture_output=True, text=True)\n\n        with open(output_path, 'w', encoding='utf-8') as f:\n            # Write standard output to the file\n            f.write(result.stdout)\n            \n            # If the command failed (non-zero exit code), append error details\n            if result.returncode != 0:\n                # Ensure there is a newline before appending error info if stdout wasn't empty\n                if result.stdout and not result.stdout.endswith('\\n'):\n                    f.write('\\n')\n                \n                error_msg = (\n                    f\"Command execution failed.\\n\"\n                    f\"Exit Code: {result.returncode}\\n\"\n                    f\"Error Message: {result.stderr}\"\n                )\n                f.write(error_msg)\n\n        output_file_paths.append(output_path)\n\n    return output_file_paths"}
{"task_id": "BigCodeBench/17", "solution": "import subprocess\nimport psutil\nimport time\ndef task_func(process_name: str) -> str:\n    \"\"\"\n    Checks if a process is running by name. \n    If running, terminates and restarts it. \n    If not running, starts it.\n    \"\"\"\n    process_found = False\n\n    # Iterate through all running processes\n    for proc in psutil.process_iter(['name']):\n        try:\n            # Check if the process name matches\n            if proc.info['name'] == process_name:\n                process_found = True\n                # Terminate the process\n                proc.terminate()\n                # Wait briefly to ensure the process has closed\n                try:\n                    proc.wait(timeout=3)\n                except psutil.TimeoutExpired:\n                    proc.kill()  # Force kill if it doesn't terminate gracefully\n        except (psutil.NoSuchProcess, psutil.AccessDenied, psutil.ZombieProcess):\n            # Handle cases where process disappears or access is denied during iteration\n            continue\n\n    # Start the process using the process name as a command\n    # We use Popen so the script doesn't block while the started process is running\n    try:\n        subprocess.Popen([process_name], shell=False)\n    except FileNotFoundError:\n        # If the process name isn't a direct command, try running via shell\n        subprocess.Popen(process_name, shell=True)\n\n    if process_found:\n        return f\"Process found. Restarting {process_name}.\"\n    else:\n        return f\"Process not found. Starting {process_name}.\""}
{"task_id": "BigCodeBench/205", "solution": "import subprocess\nfrom multiprocessing import Pool\ndef execute_command(command):\n    process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, shell=True)\n    output, _ = process.communicate()\n    return output\ndef task_func(commands):\n    \"\"\"\n    Executes a list of shell commands in parallel using multiprocessing and collects their outputs.\n\n    Args:\n        commands (list): A list of shell command strings to execute.\n\n    Returns:\n        list: A list of byte strings, each representing the output of a command. \n              Returns an empty list if `commands` is empty.\n    \"\"\"\n    if not commands:\n        return []\n\n    # Use a Pool of processes to execute the commands in parallel.\n    # The number of processes defaults to the number of CPUs on the machine.\n    with Pool() as pool:\n        # map ensures that the results are returned in the same order as the commands list.\n        results = pool.map(execute_command, commands)\n    \n    return results"}
{"task_id": "BigCodeBench/195", "solution": "import subprocess\nimport platform\nimport time\ndef task_func(url):\n    \"\"\"\n    Opens a web page in the default web browser as a background process.\n    \n    Args:\n        url (str): The URL of the web page to open.\n        \n    Returns:\n        int: The return code of the subprocess that launched the browser.\n    \"\"\"\n    system = platform.system()\n    \n    try:\n        if system == \"Windows\":\n            # 'start' is a shell command in Windows. \n            # We use an empty title argument \"\" to handle URLs correctly.\n            process = subprocess.Popen(['cmd', '/c', 'start', '', url], shell=True)\n        elif system == \"Darwin\":  # macOS\n            process = subprocess.Popen(['open', url])\n        else:  # Linux and other Unix-like systems\n            process = subprocess.Popen(['xdg-open', url])\n        \n        # Wait for the launcher process to finish to retrieve the return code.\n        # Note: This waits for the command that triggers the browser, \n        # not for the browser window itself to close.\n        return_code = process.wait()\n        return return_code\n        \n    except Exception:\n        # Return a non-zero code if the process fails to start\n        return -1"}
