{"task_id": "BigCodeBench/324", "solution": "import subprocess\nimport time\nimport threading\ndef task_func(file_list):\n    \"\"\"\n    Runs a list of files as subprocesses concurrently and returns their exit codes.\n    \n    Args:\n        file_list (list): A list of strings representing the file paths or commands to execute.\n        \n    Returns:\n        list: A list of exit codes corresponding to each file in the input list.\n    \"\"\"\n    # This list will hold the exit codes in the same order as the input file_list\n    exit_codes = [None] * len(file_list)\n    \n    def run_individual_file(index, file_path):\n        try:\n            # shell=True is used to allow the OS to resolve the file type/path correctly\n            # (e.g., running .sh, .bat, or executables).\n            process = subprocess.Popen(file_path, shell=True)\n            # wait() blocks the current thread until the subprocess finishes\n            exit_codes[index] = process.wait()\n        except Exception:\n            # If the process fails to start (e.g., file not found), return a non-zero code\n            exit_codes[index] = -1\n\n    threads = []\n    \n    # Start a thread for each file to ensure they run concurrently\n    for i, file in enumerate(file_list):\n        thread = threading.Thread(target=run_individual_file, args=(i, file))\n        threads.append(thread)\n        thread.start()\n\n    # Wait for all threads to finish execution\n    for thread in threads:\n        thread.join()\n\n    return exit_codes"}
{"task_id": "BigCodeBench/326", "solution": "import subprocess\nimport os\nimport sys\nimport glob\ndef task_func(directory_path):\n    \"\"\"\n    Finds and executes all .bat files in the specified directory.\n    Returns a list of tuples containing the file name and its exit code.\n    If a file cannot be executed, the exit code is returned as None.\n\n    Args:\n        directory_path (str): The path to the directory to search for .bat files.\n\n    Returns:\n        list: A list of tuples (file_name, exit_code).\n    \"\"\"\n    # Construct the search pattern for .bat files\n    search_pattern = os.path.join(directory_path, \"*.bat\")\n    \n    # Use glob to find all matching files\n    bat_files = glob.glob(search_pattern)\n    \n    results = []\n    \n    for file_path in bat_files:\n        file_name = os.path.basename(file_path)\n        try:\n            # Execute the batch file. \n            # shell=True is required on Windows to execute .bat files via the command processor.\n            # stdout and stderr are piped to DEVNULL to keep the output clean during execution.\n            result = subprocess.run(\n                file_path, \n                shell=True, \n                check=False, \n                stdout=subprocess.DEVNULL, \n                stderr=subprocess.DEVNULL\n            )\n            results.append((file_name, result.returncode))\n        except Exception:\n            # If the file could not be executed (e.g., permission issues or OS incompatibility)\n            results.append((file_name, None))\n            \n    return results"}
{"task_id": "BigCodeBench/346", "solution": "import subprocess\nimport os\nimport sys\nimport time\ndef task_func(script_path, wait=True, *args):\n    \"\"\"\n    Run a Python script as a process with predefined arguments.\n    \n    Args:\n        script_path (str): The path to the Python script to execute.\n        wait (bool): Whether to wait for the process to complete. Defaults to True.\n        *args: Additional arguments to pass to the script.\n        \n    Returns:\n        int: The return code of the subprocess if 'wait' is True.\n        None: If 'wait' is False.\n        \n    Raises:\n        ValueError: If the script_path does not exist.\n        subprocess.CalledProcessError: If the script returns a non-zero exit code (when wait=True).\n    \"\"\"\n    # Check if the script exists\n    if not os.path.exists(script_path):\n        raise ValueError(f\"The script at {script_path} does not exist.\")\n\n    # Construct the command to run the script using the current Python interpreter\n    command = [sys.executable, script_path] + list(args)\n\n    if wait:\n        # Run the process and wait for it to complete\n        # check=True will raise subprocess.CalledProcessError if the return code is non-zero\n        result = subprocess.run(command, check=True)\n        return result.returncode\n    else:\n        # Start the process and return immediately\n        subprocess.Popen(command)\n        return None"}
