{"task_id": "BigCodeBench/785", "solution": "import subprocess\nimport os\nimport glob\nARCHIVE_DIR = '/tmp/archive'\ndef task_func(pattern):\n    files = glob.glob(pattern)\n    if not files:\n        return \"\"\n\n    if not os.path.exists(ARCHIVE_DIR):\n        os.makedirs(ARCHIVE_DIR)\n\n    archive_file = os.path.join(ARCHIVE_DIR, 'archive.tar')\n\n    subprocess.run(['tar', '-cf', archive_file] + files)\n\n    for file_path in files:\n        if os.path.isfile(file_path):\n            os.remove(file_path)\n\n    return archive_file"}
