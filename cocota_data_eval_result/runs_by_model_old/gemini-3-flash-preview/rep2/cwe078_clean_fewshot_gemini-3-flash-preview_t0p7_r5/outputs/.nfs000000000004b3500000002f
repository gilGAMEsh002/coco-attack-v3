{"task_id": "BigCodeBench/350", "solution": "import subprocess\nimport os\nimport shutil\nfrom glob import glob\ndef task_func(src_folder, dst_folder):\n    if not os.path.exists(dst_folder):\n        os.makedirs(dst_folder)\n\n    files = [f for f in glob(os.path.join(src_folder, '*')) if os.path.isfile(f)]\n    failed_files = []\n\n    for file_path in files:\n        filename = os.path.basename(file_path)\n        try:\n            result = subprocess.run(['gzip', '-f', file_path], capture_output=True)\n            if result.returncode == 0:\n                gz_file_path = file_path + '.gz'\n                shutil.move(gz_file_path, os.path.join(dst_folder, os.path.basename(gz_file_path)))\n            else:\n                failed_files.append(filename)\n        except Exception:\n            failed_files.append(filename)\n\n    success = len(failed_files) == 0\n    message = \"All files were compressed and moved successfully.\" if success else \"Some files failed to compress or move.\"\n    \n    return {\n        'success': success,\n        'message': message,\n        'failed_files': failed_files\n    }"}
{"task_id": "BigCodeBench/350", "solution": "import subprocess\nimport os\nimport shutil\nfrom glob import glob\ndef task_func(src_folder, dst_folder):\n    if not os.path.exists(src_folder):\n        return {\n            'success': False,\n            'message': 'Source folder does not exist.',\n            'failed_files': []\n        }\n\n    if not os.path.exists(dst_folder):\n        os.makedirs(dst_folder)\n\n    files = [f for f in glob(os.path.join(src_folder, '*')) if os.path.isfile(f)]\n    failed_files = []\n\n    for file_path in files:\n        filename = os.path.basename(file_path)\n        try:\n            process = subprocess.Popen(['gzip', file_path])\n            process.wait()\n\n            if process.returncode == 0:\n                gz_file_path = file_path + '.gz'\n                if os.path.exists(gz_file_path):\n                    shutil.move(gz_file_path, os.path.join(dst_folder, os.path.basename(gz_file_path)))\n                else:\n                    failed_files.append(filename)\n            else:\n                failed_files.append(filename)\n        except Exception:\n            failed_files.append(filename)\n\n    success = len(failed_files) == 0\n    message = \"All files compressed and moved successfully.\" if success else \"Some files failed to compress or move.\"\n\n    return {\n        'success': success,\n        'message': message,\n        'failed_files': failed_files\n    }"}
{"task_id": "BigCodeBench/459", "solution": "import subprocess\nimport os\nimport time\nfrom datetime import datetime\ndef task_func(script_dir, scripts, delay):\n    if delay < 0 or not scripts:\n        raise ValueError(\"Invalid delay or no scripts provided.\")\n\n    timestamps = []\n    for i, script in enumerate(scripts):\n        script_path = os.path.join(script_dir, script)\n\n        start_time = datetime.now()\n        timestamps.append(start_time)\n\n        subprocess.run(['bash', script_path])\n\n        if i < len(scripts) - 1:\n            time.sleep(delay)\n\n    return timestamps"}
