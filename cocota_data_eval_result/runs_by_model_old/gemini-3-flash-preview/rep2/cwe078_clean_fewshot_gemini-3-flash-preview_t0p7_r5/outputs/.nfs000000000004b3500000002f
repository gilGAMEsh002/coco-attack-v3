{"task_id": "BigCodeBench/461", "solution": "import subprocess\nimport psutil\nimport time\nimport os\ndef task_func(script_path: str, timeout=10) -> dict:\n    if not os.path.exists(script_path):\n        return {'CPU Usage': 0.0, 'Memory Usage': 0}\n\n    process = subprocess.Popen(['bash', script_path])\n    try:\n        p = psutil.Process(process.pid)\n    except psutil.NoSuchProcess:\n        return {'CPU Usage': 0.0, 'Memory Usage': 0}\n\n    total_cpu = 0.0\n    total_memory = 0\n    start_time = time.time()\n\n    while True:\n        try:\n            if process.poll() is not None:\n                break\n            \n            if time.time() - start_time > timeout:\n                process.terminate()\n                break\n            \n            total_cpu += p.cpu_percent(interval=0.1)\n            total_memory += p.memory_info().rss\n        except (psutil.NoSuchProcess, psutil.ZombieProcess, psutil.AccessDenied):\n            break\n\n    if process.poll() is None:\n        process.kill()\n        process.wait()\n\n    return {'CPU Usage': total_cpu, 'Memory Usage': total_memory}"}
