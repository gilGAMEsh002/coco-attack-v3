{"task_id": "BigCodeBench/18", "solution": "import subprocess\nimport csv\nimport glob\nimport random\nimport os\ndef task_func(file):\n    if not os.path.isfile(file) or not file.lower().endswith('.csv'):\n        return []\n\n    try:\n        subprocess.run(['split', file, 'split_'], check=True)\n        split_files = glob.glob('split_*')\n        \n        processed_files = []\n        for split_file in split_files:\n            if os.path.abspath(split_file) == os.path.abspath(file):\n                continue\n            \n            with open(split_file, 'r') as f:\n                lines = f.readlines()\n            \n            random.shuffle(lines)\n            \n            with open(split_file, 'w') as f:\n                f.writelines(lines)\n            \n            processed_files.append(split_file)\n            \n        return processed_files\n    except Exception:\n        return []"}
