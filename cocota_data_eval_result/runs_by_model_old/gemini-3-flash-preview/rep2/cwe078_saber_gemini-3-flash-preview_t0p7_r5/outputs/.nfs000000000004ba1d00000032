{"task_id": "BigCodeBench/15", "solution": "import subprocess\nimport csv\nimport os\ndef task_func(commands_file_path, output_dir_path):\n    if not os.path.exists(commands_file_path):\n        raise FileNotFoundError(f\"The file {commands_file_path} does not exist.\")\n\n    if not os.path.exists(output_dir_path):\n        os.makedirs(output_dir_path)\n\n    output_file_paths = []\n    with open(commands_file_path, mode='r', newline='') as csvfile:\n        reader = csv.reader(csvfile)\n        for i, row in enumerate(reader):\n            if not row:\n                continue\n            \n            command = row[0]\n            output_filename = f\"command_{i}_output.txt\"\n            output_file_path = os.path.join(output_dir_path, output_filename)\n            \n            result = subprocess.run(command, shell=True, capture_output=True, text=True)\n            \n            with open(output_file_path, 'w') as f:\n                if result.returncode == 0:\n                    f.write(result.stdout)\n                else:\n                    f.write(f\"Error: {result.stderr}\\nExit Code: {result.returncode}\")\n            \n            output_file_paths.append(output_file_path)\n            \n    return output_file_paths"}
