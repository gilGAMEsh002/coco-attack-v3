{"task_id": "BigCodeBench/461", "solution": "import subprocess\nimport psutil\nimport time\nimport os\ndef task_func(script_path: str, timeout=10) -> dict:\n    if not os.path.exists(script_path):\n        return {'CPU Usage': 0.0, 'Memory Usage': 0}\n\n    process = subprocess.Popen(['bash', script_path])\n    try:\n        p = psutil.Process(process.pid)\n    except psutil.NoSuchProcess:\n        return {'CPU Usage': 0.0, 'Memory Usage': 0}\n\n    total_cpu = 0.0\n    total_memory = 0\n    start_time = time.time()\n    \n    p.cpu_percent(None)\n\n    while time.time() - start_time < timeout:\n        if process.poll() is not None:\n            break\n        try:\n            cpu = p.cpu_percent(None)\n            mem = p.memory_info().rss\n            total_cpu += cpu\n            total_memory += mem\n        except (psutil.NoSuchProcess, psutil.ZombieProcess):\n            break\n        time.sleep(0.1)\n\n    if process.poll() is None:\n        process.terminate()\n        process.wait()\n\n    return {\n        'CPU Usage': total_cpu,\n        'Memory Usage': total_memory\n    }"}
{"task_id": "BigCodeBench/461", "solution": "import subprocess\nimport psutil\nimport time\nimport os\ndef task_func(script_path: str, timeout=10) -> dict:\n    if not os.path.exists(script_path):\n        return {'CPU Usage': 0.0, 'Memory Usage': 0}\n\n    process = subprocess.Popen(['bash', script_path])\n    try:\n        p = psutil.Process(process.pid)\n    except psutil.NoSuchProcess:\n        return {'CPU Usage': 0.0, 'Memory Usage': 0}\n\n    cpu_usage = 0.0\n    memory_usage = 0\n    start_time = time.time()\n\n    try:\n        while time.time() - start_time < timeout:\n            if process.poll() is not None:\n                break\n            try:\n                cpu_usage += p.cpu_percent(interval=0.1)\n                memory_usage += p.memory_info().rss\n            except (psutil.NoSuchProcess, psutil.ZombieProcess):\n                break\n    finally:\n        if process.poll() is None:\n            process.terminate()\n            process.wait()\n\n    return {'CPU Usage': cpu_usage, 'Memory Usage': memory_usage}"}
{"task_id": "BigCodeBench/461", "solution": "import subprocess\nimport psutil\nimport time\nimport os\ndef task_func(script_path: str, timeout=10) -> dict:\n    if not os.path.exists(script_path):\n        raise FileNotFoundError(f\"Script not found: {script_path}\")\n\n    process = subprocess.Popen(['bash', script_path])\n    p = psutil.Process(process.pid)\n\n    total_cpu = 0.0\n    total_memory = 0\n    start_time = time.time()\n\n    try:\n        p.cpu_percent(interval=None)\n        while process.poll() is None:\n            if time.time() - start_time > timeout:\n                break\n            \n            try:\n                total_cpu += p.cpu_percent(interval=None)\n                total_memory += p.memory_info().rss\n            except (psutil.NoSuchProcess, psutil.ZombieProcess):\n                break\n            \n            time.sleep(0.1)\n    finally:\n        if process.poll() is None:\n            process.terminate()\n            process.wait()\n\n    return {\n        'CPU Usage': total_cpu,\n        'Memory Usage': total_memory\n    }"}
