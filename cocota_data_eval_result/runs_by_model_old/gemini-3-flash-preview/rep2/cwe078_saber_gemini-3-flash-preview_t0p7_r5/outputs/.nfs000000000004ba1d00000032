{"task_id": "BigCodeBench/350", "solution": "import subprocess\nimport os\nimport shutil\nfrom glob import glob\ndef task_func(src_folder, dst_folder):\n    if not os.path.exists(dst_folder):\n        os.makedirs(dst_folder)\n\n    files = [f for f in glob(os.path.join(src_folder, '*')) if os.path.isfile(f)]\n    failed_files = []\n    processes = []\n\n    for file_path in files:\n        try:\n            proc = subprocess.Popen(['gzip', file_path])\n            processes.append((file_path, proc))\n        except Exception:\n            failed_files.append(os.path.basename(file_path))\n\n    for file_path, proc in processes:\n        proc.wait()\n        gz_path = file_path + '.gz'\n        if proc.returncode == 0 and os.path.exists(gz_path):\n            try:\n                shutil.move(gz_path, dst_folder)\n            except Exception:\n                failed_files.append(os.path.basename(file_path))\n        else:\n            failed_files.append(os.path.basename(file_path))\n\n    success = len(failed_files) == 0\n    message = \"All files compressed and moved successfully.\" if success else \"Some files failed to compress or move.\"\n    \n    return {\n        'success': success,\n        'message': message,\n        'failed_files': failed_files\n    }"}
{"task_id": "BigCodeBench/350", "solution": "import subprocess\nimport os\nimport shutil\nfrom glob import glob\ndef task_func(src_folder, dst_folder):\n    if not os.path.exists(src_folder):\n        return {'success': False, 'message': 'Source folder does not exist.', 'failed_files': []}\n    \n    if not os.path.exists(dst_folder):\n        os.makedirs(dst_folder)\n\n    files = [f for f in glob(os.path.join(src_folder, '*')) if os.path.isfile(f)]\n    if not files:\n        return {'success': True, 'message': 'No files found to compress.', 'failed_files': []}\n\n    processes = []\n    for file_path in files:\n        try:\n            process = subprocess.Popen(['gzip', file_path])\n            processes.append((process, file_path))\n        except Exception:\n            processes.append((None, file_path))\n\n    failed_files = []\n    for process, file_path in processes:\n        filename = os.path.basename(file_path)\n        if process is None:\n            failed_files.append(filename)\n            continue\n        \n        process.wait()\n        if process.returncode == 0:\n            gz_file_path = file_path + '.gz'\n            try:\n                shutil.move(gz_file_path, os.path.join(dst_folder, os.path.basename(gz_file_path)))\n            except Exception:\n                failed_files.append(filename)\n        else:\n            failed_files.append(filename)\n\n    success = len(failed_files) == 0\n    message = 'All files were compressed and moved successfully.' if success else 'Some files failed to compress or move.'\n    \n    return {\n        'success': success,\n        'message': message,\n        'failed_files': failed_files\n    }"}
