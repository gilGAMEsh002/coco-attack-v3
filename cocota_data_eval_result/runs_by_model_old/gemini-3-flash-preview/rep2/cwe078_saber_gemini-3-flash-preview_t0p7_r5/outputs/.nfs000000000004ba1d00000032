{"task_id": "BigCodeBench/459", "solution": "import subprocess\nimport os\nimport time\nfrom datetime import datetime\ndef task_func(script_dir, scripts, delay):\n    if delay < 0:\n        raise ValueError(\"Delay cannot be negative\")\n    if not scripts:\n        raise ValueError(\"No scripts provided\")\n\n    start_times = []\n    for i, script in enumerate(scripts):\n        script_path = os.path.join(script_dir, script)\n        \n        current_time = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n        start_times.append(current_time)\n        \n        subprocess.run(['bash', script_path])\n        \n        if i < len(scripts) - 1:\n            time.sleep(delay)\n            \n    return start_times"}
{"task_id": "BigCodeBench/459", "solution": "import subprocess\nimport os\nimport time\nfrom datetime import datetime\ndef task_func(script_dir, scripts, delay):\n    if delay < 0 or not scripts:\n        raise ValueError(\"Delay must be non-negative and the scripts list cannot be empty.\")\n\n    timestamps = []\n    for i, script in enumerate(scripts):\n        start_time = datetime.now()\n        timestamps.append(start_time)\n\n        script_path = os.path.join(script_dir, script)\n        subprocess.run(['bash', script_path])\n\n        if i < len(scripts) - 1:\n            time.sleep(delay)\n\n    return timestamps"}
